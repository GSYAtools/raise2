{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raise2.org/schemas/experiment.schema.json",
  "title": "RAISE2 Experiment Input",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "experiment_id",
    "concern_id",
    "artefacts"
  ],

  "properties": {
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },

    "concern_id": {
      "type": "string",
      "minLength": 1
    },

    "artefacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artefact"
      }
    }
  },

  "$defs": {
    "artefact": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "id",
        "type",
        "path",
        "sha256"
      ],

      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },

        "type": {
          "type": "string",
          "enum": [
            "requirement",
            "hazard",
            "architecture",
            "policy",
            "workflow",
            "test",
            "deployment",
            "assurance",
            "other"
          ]
        },

        "path": {
          "type": "string",
          "minLength": 1
        },

        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    }
  }
}
